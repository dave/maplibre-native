{
  "version": 8,
  "metadata": {
    "test": {
      "width": 64,
      "height": 32,
      "description": "A constant or zoom-function icon-opacity outside 0..1 is clamped, as a data-driven one is: the literal 50 draws as 1, the zoom function at -50 does not draw."
    }
  },
  "center": [
    0,
    0
  ],
  "zoom": 0,
  "sources": {
    "geojson": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": [
          {
            "type": "Feature",
            "properties": {
              "o": 50
            },
            "geometry": {
              "type": "Point",
              "coordinates": [
                -11.25,
                0
              ]
            }
          },
          {
            "type": "Feature",
            "properties": {
              "o": -50
            },
            "geometry": {
              "type": "Point",
              "coordinates": [
                11.25,
                0
              ]
            }
          }
        ]
      }
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "rgb(128, 128, 128)"
      }
    },
    {
      "id": "literal",
      "type": "symbol",
      "source": "geojson",
      "layout": {
        "icon-image": "building-12",
        "icon-allow-overlap": true
      },
      "filter": [
        ">",
        [
          "get",
          "o"
        ],
        0
      ],
      "paint": {
        "icon-opacity": 50
      }
    },
    {
      "id": "zoom-function",
      "type": "symbol",
      "source": "geojson",
      "layout": {
        "icon-image": "building-12",
        "icon-allow-overlap": true
      },
      "filter": [
        "<",
        [
          "get",
          "o"
        ],
        0
      ],
      "paint": {
        "icon-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          0,
          -50,
          1,
          -50
        ]
      }
    }
  ],
  "sprite": "local://sprites/sprite"
}
