{
  "version": 8,
  "metadata": {
    "test": {
      "width": 64,
      "height": 32,
      "description": "A constant or zoom-function text-opacity outside 0..1 is clamped, as a data-driven one is: the literal 50 draws as 1, the zoom function at -50 does not draw."
    }
  },
  "center": [
    0,
    0
  ],
  "zoom": 0,
  "sources": {
    "geojson": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": [
          {
            "type": "Feature",
            "properties": {
              "o": 50
            },
            "geometry": {
              "type": "Point",
              "coordinates": [
                -11.25,
                0
              ]
            }
          },
          {
            "type": "Feature",
            "properties": {
              "o": -50
            },
            "geometry": {
              "type": "Point",
              "coordinates": [
                11.25,
                0
              ]
            }
          }
        ]
      }
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "rgb(128, 128, 128)"
      }
    },
    {
      "id": "literal",
      "type": "symbol",
      "source": "geojson",
      "layout": {
        "text-field": "Aa",
        "text-font": [
          "Open Sans Semibold",
          "Arial Unicode MS Bold"
        ],
        "text-size": 16,
        "text-allow-overlap": true
      },
      "filter": [
        ">",
        [
          "get",
          "o"
        ],
        0
      ],
      "paint": {
        "text-color": "rgb(0, 128, 0)",
        "text-opacity": 50
      }
    },
    {
      "id": "zoom-function",
      "type": "symbol",
      "source": "geojson",
      "layout": {
        "text-field": "Aa",
        "text-font": [
          "Open Sans Semibold",
          "Arial Unicode MS Bold"
        ],
        "text-size": 16,
        "text-allow-overlap": true
      },
      "filter": [
        "<",
        [
          "get",
          "o"
        ],
        0
      ],
      "paint": {
        "text-color": "rgb(0, 128, 0)",
        "text-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          0,
          -50,
          1,
          -50
        ]
      }
    }
  ],
  "glyphs": "local://glyphs/{fontstack}/{range}.pbf"
}
