{
  "version": 8,
  "metadata": {
    "test": {
      "width": 64,
      "height": 32,
      "description": "A constant or zoom-function fill-opacity outside 0..1 is clamped, as a data-driven one is: the literal 50 draws as 1, the zoom function at -50 does not draw."
    }
  },
  "center": [
    0,
    0
  ],
  "zoom": 0,
