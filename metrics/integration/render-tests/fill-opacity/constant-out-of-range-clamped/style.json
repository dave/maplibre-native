          {
            "type": "Feature",
            "properties": {
              "o": 50
            },
            "geometry": {
              "type": "Polygon",
              "coordinates": [
                [
                  [
                    -22.5,
                    -5.625
                  ],
                  [
                    -22.5,
                    5.625
                  ],
                  [
                    -5.625,
                    5.625
                  ],
                  [
                    -5.625,
                    -5.625
                  ],
                  [
                    -22.5,
                    -5.625
                  ]
                ]
              ]
            }
          },
          {
            "type": "Feature",
            "properties": {
              "o": -50
            },
            "geometry": {
              "type": "Polygon",
              "coordinates": [
                [
                  [
                    5.625,
                    -5.625
                  ],
                  [
                    5.625,
                    5.625
                  ],
                  [
                    22.5,
                    5.625
                  ],
                  [
                    22.5,
                    -5.625
                  ],
                  [
                    5.625,
                    -5.625
                  ]
                ]
              ]
            }
          }
        ]
      }
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "rgb(128, 128, 128)"
      }
    },
    {
      "id": "literal",
      "type": "fill",
      "source": "geojson",
      "layout": {},
      "filter": [
        ">",
        [
          "get",
          "o"
        ],
        0
      ],
      "paint": {
        "fill-color": "rgb(0, 128, 0)",
        "fill-antialias": false,
        "fill-opacity": 50
      }
