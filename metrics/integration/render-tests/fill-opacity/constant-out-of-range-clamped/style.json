    {
      "id": "zoom-function",
      "type": "fill",
      "source": "geojson",
      "layout": {},
      "filter": [
        "<",
        [
          "get",
          "o"
        ],
        0
      ],
      "paint": {
        "fill-color": "rgb(0, 128, 0)",
        "fill-antialias": false,
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
