{
  "version": 8,
  "metadata": {
    "test": {
      "height": 256,
      "width": 256,
      "description": "Basic native contour source: a single line layer renders contours derived from the upstream raster-dem source. Centred on a single z=12 terrain tile with ~1000m elevation variation; intervals=100m yields ~10 contour bands per tile."
    }
  },
  "center": [
    -113.26903,
    35.9654
  ],
  "zoom": 12,
  "sources": {
    "dem": {
      "type": "raster-dem",
      "tiles": [
        "local://tiles/{z}-{x}-{y}.terrain.png"
      ],
      "maxzoom": 12,
      "tileSize": 256
    },
    "contours": {
      "type": "contour",
      "source": "dem",
      "intervals": [
        100
      ],
      "unit": "meters"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "white"
      }
    },
    {
      "id": "contour-lines",
      "type": "line",
      "source": "contours",
      "paint": {
        "line-color": "#7c4a14",
        "line-width": 1
      }
    }
  ]
}